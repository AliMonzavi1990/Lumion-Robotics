{
  "name": "lumion-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "setup": "npm install && npm --prefix backend install",
    "db:up": "docker compose up -d",
    "db:setup": "npm --prefix backend run db:setup",
    "api": "npm --prefix backend start",
    "sim": "npm --prefix backend run sim",
    "ai": "npm --prefix backend run ai",
    "test": "npm --prefix backend test",
    "start:all": "npm run db:up && concurrently -k -n API,SIM,AI,WEB \"npm run api\" \"wait-on http-get://localhost:3000/health && npm run sim\" \"wait-on http-get://localhost:3000/health && npm run ai\" \"npm run dev\""
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
